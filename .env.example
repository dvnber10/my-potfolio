# Url de la API del backend de Portfolio.
#
# OBLIGATORIA en producción: sin ella el portafolio funciona solo con los
# datos locales (src/data/cv.json) y el panel /admin queda deshabilitado.
#
# En desarrollo (npm start) NO hace falta definirla: el frontend se conecta
# automáticamente a http://localhost:5227
REACT_APP_API_URL=https://tu-api.up.railway.app